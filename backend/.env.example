# Optional. When configured, synthetic case text is sent to Groq for summary generation.
# Never use real patient information in this demonstration app.
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated browser origins allowed to call the API. Same-origin production needs no CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
